# auto = try Mongo first, else SQLite (data/learnflow.db). Use mongo | sqlite to force.
DATABASE_MODE=auto
SQLITE_PATH=data/learnflow.db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=learnflow
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:4200
